#!/bin/sh

home="$(pwd)"
basedir="${home}/tests/basedir"

####

_sanitize() {
  sed \
    -e "s!${basedir}!...!g" \
    -e "s!${home}!...!g"
}

_check() {
  { "$@" 2>&1; echo "$?"; } | _sanitize
}

_check_err() {
  { "$@" 2>&1; echo "$?"; } | grep -E 'fatal:|^[0-9]+' | _sanitize
}

_run() {
  printf '\n\n==== %s ====\n\n'  "$1"
}

_json() {
  jq -r "$@" | _sanitize
}

_cbt() {
  { printf '%s\n' "$@" | sed 's/\\t/	/' | ./cbt 2>&1; echo "$?"; } | _sanitize
}

_cbt_installed() {
  { printf '%s\n' "$@" | sed 's/\\t/	/' | "${home}/tests/prefix/bin/cbt" 2>&1; echo "$?"; } | _sanitize
}

_hex() {
  od -An -tx1 | tr -d ' \n'
  printf '\n'
}

####

rm -rf "${basedir:?}/"*
rmdir "${basedir}" 2>/dev/null; true

####


_run critbit0-baseline
mkdir -p "${basedir}"
if ! "${CC:-cc}" -I. -o "${basedir}/critbit0_baseline" \
  tests/critbit0_baseline.c \
  critbit0_contains.c critbit0_insert.c critbit0_delete.c \
  critbit0_clear.c critbit0_firstprefixed.c critbit0_allprefixed.c \
  str0_length.c str0_equalc.c str0_copyc.c str0_free.c \
  limitmalloc_open.c limitmalloc_open_if2.c limitmalloc_close.c \
  2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/critbit0_baseline"

_run critbit0-operations
if ! "${CC:-cc}" -I. -o "${basedir}/critbit0_operations" \
  tests/critbit0_operations.c \
  critbit0_contains.c critbit0_insert.c critbit0_delete.c \
  critbit0_clear.c critbit0_firstprefixed.c critbit0_allprefixed.c \
  str0_length.c str0_equalc.c str0_copyc.c str0_free.c \
  limitmalloc_open.c limitmalloc_open_if2.c limitmalloc_close.c \
  2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/critbit0_operations"

_run critbit0-installed
if ! "${CC:-cc}" -I"${home}/tests/prefix/include" \
  -o "${basedir}/critbit0_installed" tests/critbit0_installed.c \
  -L"${home}/tests/prefix/lib" -lcritbit0 \
  2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/critbit0_installed"

_run installed-library-command-consistency
if ! "${CC:-cc}" -I"${home}/tests/prefix/include" \
  -o "${basedir}/critbit0_cbt" tests/critbit0_cbt.c \
  -L"${home}/tests/prefix/lib" -lcritbit0 \
  2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
if ! "${basedir}/critbit0_cbt" > "${basedir}/requests"
then
  printf '%s\n' 'installed library request generation failed' >&2
  exit 1
fi
{ "${home}/tests/prefix/bin/cbt" < "${basedir}/requests" 2>&1; echo "$?"; } | _sanitize

_run cbt-retained-state
_cbt 'insert\talpha' 'contains\talpha' 'insert\talpha' 'contains\tbeta'

_run cbt-delete
_cbt 'delete\tx' 'insert\tx' 'delete\tx' 'contains\tx'

_run cbt-clear
_cbt 'insert\tx' 'clear' 'contains\tx' 'clear'

_run cbt-firstprefixed
_cbt 'firstprefixed\ta' 'insert\tab' 'firstprefixed\ta' 'firstprefixed\tz'

_run cbt-allprefixed
_cbt 'allprefixed\tz' 'insert\tab' 'insert\tac' 'allprefixed\ta'

_run cbt-contains-absent-lf
_cbt 'contains\tx'

_run cbt-contains-present-lf
_cbt 'insert\tx' 'contains\tx'

_run cbt-insert-added-lf
_cbt 'insert\tx'

_run cbt-insert-existing-lf
_cbt 'insert\tx' 'insert\tx'

_run cbt-delete-missing-lf
_cbt 'delete\tx'

_run cbt-delete-present-lf
_cbt 'insert\tx' 'delete\tx'

_run cbt-clear-silent-lf
_cbt 'clear'

_run cbt-allprefixed-full-keys
_cbt 'insert\tab' 'insert\tac' 'allprefixed\ta'

_run cbt-allprefixed-unmatched
_cbt 'allprefixed\tz'

_run cbt-empty-key
_cbt 'insert\t' 'contains\t' 'firstprefixed\t' 'allprefixed\t'

_run cbt-allprefixed-empty-key-refusal
{ printf 'insert\t\nallprefixed\t\n' | ./cbt > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"
cat "${basedir}/load-error"

_run cbt-insert-allocation-failure
cat > "${basedir}/cbt_insert_failure.c" <<'EOF'
#define main cbt_program_main
#include "../../cbt.c"
#undef main

int main(void)
{
  critbit0_tree tree = { 0 };
  limitmalloc_pool pool = { 0, 0, 0 };
  char request[] = "insert\tx";
  return dispatch(request, &tree, &pool) == 1 ? 0 : 1;
}
EOF
if ! "${CC:-cc}" -I. -o "${basedir}/cbt_insert_failure" \
  "${basedir}/cbt_insert_failure.c" libcritbit0.a 2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/cbt_insert_failure"

_run cbt-raw-lf-bytes
{ printf 'insert\tA\\\t\001\177\ncontains\tA\\\t\001\177\nfirstprefixed\tA\nallprefixed\tA\n' \
| "${home}/tests/prefix/bin/cbt" > "${basedir}/raw-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"

_run cbt-literal-old-escapes
{ printf 'insert\tA\\n\\x41\nfirstprefixed\tA\n' \
| "${home}/tests/prefix/bin/cbt" > "${basedir}/raw-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"

_run cbt-invalid-verb
_cbt 'unknown\tx' 'insert\tx'

_run cbt-invalid-nul
{ printf 'insert\tx\000y\n' | "${home}/tests/prefix/bin/cbt" 2>&1; echo "$?"; } | _sanitize

_run cbt-lf-boundary
{ printf 'insert\tx\ny\n' | "${home}/tests/prefix/bin/cbt" 2>&1; echo "$?"; } | _sanitize

_run cbt-unterminated
{ printf 'insert\tx' | ./cbt 2>&1; echo "$?"; } | _sanitize

_run cbt-nul-stream
{ printf 'insert\tpre\n\t\\z\000contains\tpre\n\t\\z\000firstprefixed\tpre\000allprefixed\tpre\000' \
| "${home}/tests/prefix/bin/cbt" -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-contains-absent-nul
{ printf 'contains\tx\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-contains-present-nul
{ printf 'insert\tx\000contains\tx\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-insert-added-nul
{ printf 'insert\tx\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-insert-existing-nul
{ printf 'insert\tx\000insert\tx\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-delete-missing-nul
{ printf 'delete\tx\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-delete-present-nul
{ printf 'insert\tx\000delete\tx\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-clear-silent-nul
{ printf 'clear\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-nul-statuses
: > "${basedir}/nul-empty"
{ printf 'contains\tx\000insert\tx\000insert\tx\000delete\ty\000delete\tx\000firstprefixed\tx\000allprefixed\tx\000clear\000save\ttests/basedir/nul-empty\000load\ttests/basedir/nul-empty\000' \
| "${home}/tests/prefix/bin/cbt" -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-nul-incomplete
{ printf 'insert\tx' | "${home}/tests/prefix/bin/cbt" -0 > "${basedir}/nul-output" 2>&1; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-unsupported-option
{ "${home}/tests/prefix/bin/cbt" -x > "${basedir}/nul-output" 2>&1; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-snapshot-roundtrip
_cbt 'insert\tB' 'insert\tA' \
  'save\ttests/basedir/snapshot' 'clear' \
  'load\ttests/basedir/snapshot' 'contains\tA' 'contains\tB'
cat "${basedir}/snapshot" | _sanitize

_run cbt-nul-snapshot
{ printf 'insert\tA\nB\000insert\tC\000save\ttests/basedir/nul-snapshot\000clear\000load\ttests/basedir/nul-snapshot\000contains\tA\nB\000contains\tC\000' \
| "${home}/tests/prefix/bin/cbt" -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"
_hex < "${basedir}/nul-snapshot"

_run cbt-snapshot-other-mode
{ printf 'insert\tretained\000load\ttests/basedir/snapshot\000' \
| "${home}/tests/prefix/bin/cbt" -0 > "${basedir}/nul-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"
cat "${basedir}/load-error"
{ printf 'insert\tretained\nload\ttests/basedir/nul-snapshot\n' \
| "${home}/tests/prefix/bin/cbt" > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"
cat "${basedir}/load-error"

_run cbt-snapshot-empty
: > "${basedir}/empty"
{ printf 'load\ttests/basedir/empty\n' | ./cbt > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"
cat "${basedir}/load-error"

_run cbt-load-empty-nul
: > "${basedir}/empty-nul"
{ printf 'load\ttests/basedir/empty-nul\000' | ./cbt -0 > "${basedir}/nul-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"
cat "${basedir}/load-error"

_run cbt-write-lf
{ printf 'insert\tB\ninsert\tA\nwrite\n' | "${home}/tests/prefix/bin/cbt" > "${basedir}/raw-output"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"

_run cbt-read-lf
{ printf 'insert\tkept\nread\nA\nB\n\ncontains\tA\ncontains\tkept\ncontains\tB\n' | ./cbt > "${basedir}/raw-output"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"

_run cbt-write-nul
{ printf 'insert\tB\000insert\tA\000write\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-read-nul
{ printf 'insert\tkept\000read\000A\000B\000\000contains\tA\000contains\tkept\000contains\tB\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-save-ab-lf
{ printf 'insert\tB\ninsert\tA\nsave\ttests/basedir/ab-lf\n' | ./cbt > "${basedir}/raw-output"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"
_hex < "${basedir}/ab-lf"

_run cbt-save-ab-nul
{ printf 'insert\tB\000insert\tA\000save\ttests/basedir/ab-nul\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"
_hex < "${basedir}/ab-nul"

_run cbt-save-empty-lf
{ printf 'save\ttests/basedir/empty-tree\n' | ./cbt > "${basedir}/raw-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"
_hex < "${basedir}/empty-tree"

_run cbt-save-empty-nul
{ printf 'save\ttests/basedir/empty-tree-nul\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"
_hex < "${basedir}/empty-tree-nul"

_run cbt-load-after-marker
printf 'A\n\nB\n' > "${basedir}/after-marker"
{ printf 'load\ttests/basedir/after-marker\n' | ./cbt > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"
cat "${basedir}/load-error"

_run cbt-load-marker-only
printf '\n' > "${basedir}/marker-only"
{ printf 'insert\tx\nload\ttests/basedir/marker-only\ncontains\tx\n' | ./cbt > "${basedir}/raw-output"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"

_run cbt-load-missing-marker
printf 'A\nB\n' > "${basedir}/no-marker"
{ printf 'insert\tkept\nload\ttests/basedir/no-marker\n' | ./cbt > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"
cat "${basedir}/load-error"

_run cbt-write-empty-lf
{ printf 'write\n' | ./cbt > "${basedir}/raw-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"

_run cbt-read-empty
{ printf 'insert\tx\nread\n\ncontains\tx\n' | ./cbt > "${basedir}/raw-output"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"

_run cbt-read-missing-marker
{ printf 'insert\tkept\nread\nA\n' | ./cbt > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"
cat "${basedir}/load-error"
cat > "${basedir}/cbt_read_missing.c" <<'EOF'
#define main cbt_program_main
#include "../../cbt.c"
#undef main

int main(void)
{
  critbit0_tree tree = { 0 };
  limitmalloc_pool pool = { LIMITMALLOC_MAX, 0, 0 };
  str0 key = "kept";
  FILE *input;

  if (critbit0_insert(&tree, &pool, &key) != 2) return 1;
  input = fopen("tests/basedir/read-missing", "w");
  if (!input) return 1;
  if (fputs("A\n", input) == EOF || fclose(input) == EOF) return 1;
  if (!freopen("tests/basedir/read-missing", "r", stdin)) return 1;
  if (read_snapshot(&tree, &pool) == 0) return 1;
  if (!critbit0_contains(&tree, &key)) return 1;
  printf("retained: yes\n");
  critbit0_clear(&tree, &pool);
  return 0;
}
EOF
if ! "${CC:-cc}" -I. -o "${basedir}/cbt_read_missing" \
  "${basedir}/cbt_read_missing.c" libcritbit0.a 2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/cbt_read_missing"

_run cbt-write-empty-key
{ printf 'insert\t\nwrite\n' | ./cbt > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"
cat "${basedir}/load-error"

_run cbt-save-empty-key
{ printf 'insert\t\nsave\ttests/basedir/empty-key-save\n' | ./cbt > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"
cat "${basedir}/load-error"
test ! -e "${basedir}/empty-key-save"
echo "$?"

_run cbt-snapshot-invalid
printf 'valid\nx\000y\n' > "${basedir}/invalid"
_cbt_installed 'insert\tx' 'load\ttests/basedir/invalid' 'contains\tx'

_run cbt-snapshot-lf-boundary
printf 'valid\nunterminated' > "${basedir}/invalid"
_cbt_installed 'insert\tx' 'load\ttests/basedir/invalid' 'contains\tx'

_run cbt-snapshot-raw-bytes
{ printf 'insert\tA\\\t\001\177\ninsert\tA\\n\\x41\nsave\ttests/basedir/raw-snapshot\nclear\nload\ttests/basedir/raw-snapshot\ncontains\tA\\\t\001\177\ncontains\tA\\n\\x41\n' \
| "${home}/tests/prefix/bin/cbt" > "${basedir}/raw-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"
_hex < "${basedir}/raw-snapshot"

_run cbt-snapshot-missing
_cbt_installed 'insert\tx' 'load\ttests/basedir/missing'

_run cbt-snapshot-save-symlink
printf 'prior\n' > "${basedir}/prior"
ln -s prior "${basedir}/link"
_cbt_installed 'insert\tx' 'save\ttests/basedir/link'
cat "${basedir}/prior"

_run cbt-installed-all-bytes
awk 'BEGIN {
  key = ""
  for (i = 1; i < 256; i++) {
    if (i != 10) key = key sprintf("%c", i)
  }
  printf "insert\t%s\nsave\ttests/basedir/all-bytes\nclear\nload\ttests/basedir/all-bytes\ncontains\t%s\n", key, key
}' | "${home}/tests/prefix/bin/cbt" 2>&1 | _sanitize

_run cbt-installed-executable
test -x "${home}/tests/prefix/bin/cbt"
echo "$?"

_run cbt-snapshot-rollback
printf 'prior\n' > "${basedir}/rollback"
if ! "${CC:-cc}" -I. -o "${basedir}/cbt_snapshots" \
  tests/cbt_snapshots.c libcritbit0.a 2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/cbt_snapshots" "${basedir}/bad-load" "${basedir}/rollback"
