_hex < "${basedir}/nul-output"

_run cbt-response-per-request-lf
_exchange '' 'add a\n' 'has a\n'

_run cbt-response-per-request-nul
_exchange -0 'add a\000' 'has a\000'

_run cbt-closed-output
{ awk 'BEGIN { for (i = 0; i < 100000; i++) print "add k" i }' \
| "${home}/tests/prefix/bin/cbt" 2> "${basedir}/pipe-error"; echo "$?" > "${basedir}/pipe-status"; } | true
cat "${basedir}/pipe-error" "${basedir}/pipe-status"

_run cbt-read-unordered-lf
_cbt_installed 'read' 'b' 'a' 'b' '' 'write'

_run cbt-read-unordered-nul
{ printf 'read\000b\000a\000b\000\000write\000' | "${home}/tests/prefix/bin/cbt" -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-load-unordered-lf
printf 'b\na\nb\n\n' > "${basedir}/unordered"
_cbt 'load tests/basedir/unordered' 'write'

_run make-header-dependencies
_make_stubs "${basedir}/make"
(
  cd "${basedir}/make" || exit 1
  for header in critbit0.h str0.h limitmalloc.h int64.h uint8.h uint32.h uint64.h
  do
    touch -t 200001020000 "${header}"
    for target in critbit0_insert.o str0_free.o limitmalloc_open.o cbt
    do
      "${MAKE:-make}" -q "${target}" > /dev/null 2>&1
      printf '%s %s %s\n' "${header}" "${target}" "$?"
    done
    touch -t 200001010000 "${header}"
  done
)

_run make-clean
_make_stubs "${basedir}/make-clean"
(
  cd "${basedir}/make-clean" || exit 1
  mkdir -p tests/basedir/sub tests/prefix/bin
  : > tests/output
  : > tests/basedir/sub/file
  : > tests/prefix/bin/cbt
  "${MAKE:-make}" clean > /dev/null 2>&1
  echo "$?"
  ls tests
  ls | grep -E '[.]o$|^libcritbit0[.]a$|^cbt$'
  ls cbt.c critbit0.h
)

_run make-failed-cbt-leaves-no-temp
_make_stubs "${basedir}/make-cbt"
(
  cd "${basedir}/make-cbt" || exit 1
  touch -t 200001020000 cbt.c
  if "${MAKE:-make}" CC=false cbt > /dev/null 2>&1
  then
    echo built
  else
    echo failed
  fi
  ls | grep '^cbt'
)

_run make-failed-library-leaves-no-temp
_make_stubs "${basedir}/make-library"
(
  cd "${basedir}/make-library" || exit 1
  touch -t 200001020000 critbit0_insert.o
  if "${MAKE:-make}" AR=false libcritbit0.a > /dev/null 2>&1
  then
    echo built
  else
    echo failed
  fi
  ls | grep '^libcritbit0'
)

_run make-install-over-running-cbt
rm -rf "${basedir}/install"
"${MAKE:-make}" install PREFIX="${basedir}/install" > /dev/null 2>&1
echo "$?"
mkfifo "${basedir}/install-in"
"${basedir}/install/bin/cbt" < "${basedir}/install-in" > "${basedir}/install-out" &
pid="$!"
exec 5> "${basedir}/install-in"
"${MAKE:-make}" install PREFIX="${basedir}/install" > /dev/null 2>&1
echo "$?"
cmp cbt "${basedir}/install/bin/cbt"
echo "$?"
printf 'add a\n' >&5
exec 5>&-
wait "${pid}"
echo "$?"
cat "${basedir}/install-out"

_run make-install-modes
ls -l "${basedir}/install/bin/cbt" "${basedir}/install/lib/libcritbit0.a" "${basedir}/install/include/critbit0.h" \
| awk '{ print $1, $NF }' | _sanitize
ls "${basedir}/install/bin" "${basedir}/install/lib" "${basedir}/install/include" | _sanitize

_run make-install-failure-leaves-no-temp
_make_stubs "${basedir}/make-install"
(
  cd "${basedir}/make-install" || exit 1
  rm -f cbt
  mkdir cbt prefix prefix/bin
  touch -t 200001010000 cbt
  printf 'prior\n' > prefix/bin/cbt
  if "${MAKE:-make}" install PREFIX=prefix > /dev/null 2>&1
  then
    echo installed
  else
    echo failed
  fi
  cat prefix/bin/cbt
  ls prefix/bin
)
