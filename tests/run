#!/bin/sh

home="$(pwd)"
basedir="${home}/tests/basedir"

####

_sanitize() {
  sed \
    -e "s!${basedir}!...!g" \
    -e "s!${home}!...!g"
}

_check() {
  { "$@" 2>&1; echo "$?"; } | _sanitize
}

_check_err() {
  { "$@" 2>&1; echo "$?"; } | grep -E 'fatal:|^[0-9]+' | _sanitize
}

_run() {
  printf '\n\n==== %s ====\n\n'  "$1"
}

_json() {
  jq -r "$@" | _sanitize
}

_cbt() {
  { printf '%s\n' "$@" | sed 's/\\t/	/' | ./cbt 2>&1; echo "$?"; } | _sanitize
}

_cbt_installed() {
  { printf '%s\n' "$@" | sed 's/\\t/	/' | "${home}/tests/prefix/bin/cbt" 2>&1; echo "$?"; } | _sanitize
}

_hex() {
  od -An -tx1 | tr -d ' \n'
  printf '\n'
}

# _exchange option request...
#   Send each printf-format request to one running installed cbt and print
#   the two-byte response that arrives before the next request is sent.
_exchange() {
  local option="$1"
  shift
  local in="${basedir}/exchange-in"
  local out="${basedir}/exchange-out"
  local pid
  local watchdog
  local request

  rm -f "${in}" "${out}"
  mkfifo "${in}" "${out}"
  if test -n "${option}"
  then
    "${home}/tests/prefix/bin/cbt" "${option}" < "${in}" > "${out}" &
  else
    "${home}/tests/prefix/bin/cbt" < "${in}" > "${out}" &
  fi
  pid="$!"
  { sleep 5; kill "${pid}"; } > /dev/null 2>&1 &
  watchdog="$!"
  exec 3> "${in}" 4< "${out}"
  for request in "$@"
  do
    ( printf "${request}" >&3 ) 2> /dev/null
    dd bs=1 count=2 <&4 2> /dev/null | _hex
  done
  exec 3>&-
  wait "${pid}"
  echo "$?"
  exec 4<&-
  kill "${watchdog}" 2> /dev/null
  rm -f "${in}" "${out}"
}

# _make_stubs dir
#   Copy the Makefile into dir beside empty, equally old stand-ins for the
#   sources, headers, library objects, library, and cbt.
_make_stubs() {
  local dir="$1"
  local path
  local name

  mkdir -p "${dir}"
  cp Makefile "${dir}/Makefile"
  for path in "${home}"/*.c "${home}"/*.h
  do
    name="${path##*/}"
    : > "${dir}/${name}"
    case "${name}" in
      (cbt.c) ;;
      (*.c) : > "${dir}/${name%.c}.o";;
    esac
  done
  : > "${dir}/libcritbit0.a"
  : > "${dir}/cbt"
  touch -t 200001010000 "${dir}"/*
}

