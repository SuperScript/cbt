_hex < "${basedir}/nul-output"

_run cbt-after-empty-unmatched-nul
{ printf 'after \000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-after-empty-matched-nul
{ printf 'add x\000after \000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-list-empty-unmatched-nul
