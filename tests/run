_run critbit0-dump-early-stop
cat > "${basedir}/critbit0_dump_stop.c" <<'EOF'
#include <stdio.h>
#include <critbit0.h>

static int calls;
static int stop_at;
static int64 bytes;

static int put(const char *data, int64 length)
{
  (void) data;
  ++calls;
  bytes += length;
  return calls != stop_at;
}

int main(void)
{
  critbit0_tree tree = { 0 };
  limitmalloc_pool pool = { LIMITMALLOC_MAX, 0, 0 };
  str0 a = "a", b = "b";
  int total;
  int result;

  if (critbit0_insert(&tree, &pool, &a) != 2 ||
      critbit0_insert(&tree, &pool, &b) != 2) return 1;
  stop_at = 0;
  result = critbit0_dump(&tree, put);
  total = calls;
  printf("full: result %d, calls %d, bytes %lld\n", result, calls,
         (long long) bytes);
  for (stop_at = 1; stop_at <= total; ++stop_at) {
    calls = 0;
    result = critbit0_dump(&tree, put);
    printf("stop at %d: result %d, calls %d\n", stop_at, result, calls);
  }
  critbit0_clear(&tree, &pool);
  return 0;
}
EOF
if ! "${CC:-cc}" -I"${home}/tests/prefix/include" \
  -o "${basedir}/critbit0_dump_stop" "${basedir}/critbit0_dump_stop.c" \
  -L"${home}/tests/prefix/lib" -lcritbit0 2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/critbit0_dump_stop"

_run critbit0-image-operations
cat > "${basedir}/critbit0_image_operations.c" <<'EOF'
#include <errno.h>
#include <stdio.h>
#include <string.h>
#include <critbit0.h>

static char bytes[4096];
static char damaged[4096];
static int64 length;
static str0 suffix;
static int calls;
static int stop_at;

static int put(const char *data, int64 n)
{
  memcpy(bytes + length, data, (size_t) n);
  length += n;
  return 1;
}

static int show(void)
{
  ++calls;
  printf("  [%s]\n", suffix);
  return calls != stop_at;
}

static void set64(char *at, unsigned long long u)
{
  int i;

  for (i = 0; i < 8; ++i) { at[i] = (char) u; u >>= 8; }
}

/* Store reference r at offset in a copy of the dump, then look up probe. */
static void bad_child(const char *name, int offset, unsigned long long r,
                      const char *probe)
{
  limitmalloc_pool pool = { LIMITMALLOC_MAX, 0, 0 };
  critbit0_image bad;
  str0 key = (str0) probe;
  str0 result = 0;

  memcpy(damaged, bytes, (size_t) length);
  set64(damaged + offset, r);
  if (!critbit0_image_init(&bad, damaged, length)) {
    printf("%s: init failed\n", name);
    return;
  }
  printf("%s: contains %d, firstprefixed %d, allprefixed %d\n", name,
         critbit0_image_contains(&bad, &key),
         critbit0_image_firstprefixed(&bad, &pool, &result, &key),
         critbit0_image_allprefixed(&bad, &pool, &suffix, &key, show));
}

int main(void)
{
  critbit0_tree tree = { 0 };
  limitmalloc_pool pool = { LIMITMALLOC_MAX, 0, 0 };
  limitmalloc_pool empty_pool = { 0, 0, 0 };
  critbit0_image image;
  critbit0_image bad;
  const char *probes[] = { "a", "ca", "cb", "c", "", "x", "cab", 0 };
  str0 ca = "ca", cb = "cb", a = "a";
  str0 key;
  str0 result = 0;
  int i;
  int r;

  if (critbit0_insert(&tree, &pool, &ca) != 2 ||
      critbit0_insert(&tree, &pool, &cb) != 2 ||
      critbit0_insert(&tree, &pool, &a) != 2 ||
      !critbit0_dump(&tree, put)) return 1;

  printf("init short: %d\n", critbit0_image_init(&image, bytes, 31));
  printf("init length mismatch: %d\n",
         critbit0_image_init(&image, bytes, length - 8));
  memcpy(damaged, bytes, (size_t) length);
  damaged[0] = 'C';
  printf("init magic: %d\n", critbit0_image_init(&bad, damaged, length));
  memcpy(damaged, bytes, (size_t) length);
  damaged[8] = 2;
  printf("init version: %d\n", critbit0_image_init(&bad, damaged, length));
  memcpy(damaged, bytes, (size_t) length);
  set64(damaged + 24, 36);
  printf("init unaligned root: %d\n",
         critbit0_image_init(&bad, damaged, length));
  memcpy(damaged, bytes, (size_t) length);
  set64(damaged + 24, (unsigned long long) length + 1);
  printf("init root past end: %d\n",
         critbit0_image_init(&bad, damaged, length));
  memcpy(damaged, bytes, (size_t) length);
  set64(damaged + 24, 24);
  printf("init root in header: %d\n",
         critbit0_image_init(&bad, damaged, length));
  memcpy(damaged, bytes, (size_t) length);
  set64(damaged + 24, (unsigned long long) length - 16 + 1);
  printf("init root node too short: %d\n",
         critbit0_image_init(&bad, damaged, length));
  printf("init: %d\n", critbit0_image_init(&image, bytes, length));

  for (i = 0; probes[i]; ++i) {
    key = (str0) probes[i];
    printf("contains [%s]: tree %d, image %d\n", probes[i],
           critbit0_contains(&tree, &key),
           critbit0_image_contains(&image, &key));
  }
  for (i = 0; probes[i]; ++i) {
    key = (str0) probes[i];
    r = critbit0_image_firstprefixed(&image, &pool, &result, &key);
    printf("firstprefixed [%s]: %d", probes[i], r);
    if (r == 1) {
      printf(" [%s]", result);
      str0_free(&result, &pool);
    }
    printf("\n");
  }

  key = "c";
  stop_at = 0;
  calls = 0;
  printf("allprefixed [c]:\n");
  printf("  result %d\n",
         critbit0_image_allprefixed(&image, &pool, &suffix, &key, show));
  key = "";
  calls = 0;
  stop_at = 2;
  printf("allprefixed [] stop at 2:\n");
  printf("  result %d\n",
         critbit0_image_allprefixed(&image, &pool, &suffix, &key, show));
  printf("allprefixed [] null callback: %d [%s]\n",
         critbit0_image_allprefixed(&image, &pool, &suffix, &key, 0), suffix);
  key = "x";
  printf("allprefixed [x]: %d\n",
         critbit0_image_allprefixed(&image, &pool, &suffix, &key, show));
  str0_free(&suffix, &pool);

  key = "c";
  errno = 0;
  r = critbit0_image_firstprefixed(&image, &empty_pool, &result, &key);
  printf("firstprefixed out of memory: %d, ENOMEM %d\n", r, errno == ENOMEM);
  printf("allprefixed out of memory: %d\n",
         critbit0_image_allprefixed(&image, &empty_pool, &suffix, &key, show));

  /* The key a is the first record and the root node the last; fill every
     byte between them so the key's NUL lies past its parent. */
  memcpy(damaged, bytes, (size_t) length);
  memset(damaged + 32, 'a', (size_t) (length - 24 - 32));
  if (!critbit0_image_init(&bad, damaged, length)) return 1;
  key = "a";
  printf("unterminated key: contains %d, firstprefixed %d, allprefixed %d\n",
         critbit0_image_contains(&bad, &key),
         critbit0_image_firstprefixed(&bad, &pool, &result, &key),
         critbit0_image_allprefixed(&bad, &pool, &suffix, &key, show));

  /* Records: a at 32, ca at 40, cb at 48, the ca/cb node at 56, the root
     node at 80 with child 0 at 80 and child 1 at 88. */
  bad_child("child 0 unaligned", 80, 36, "a");
  bad_child("child 0 in header", 80, 16, "a");
  bad_child("child 0 node in header", 80, 17, "a");
  bad_child("child 1 node too short", 88, 73, "ca");

  /* Damage cb, which only the walk under the empty prefix reaches, after
     the callbacks for a and ca. */
  memcpy(damaged, bytes, (size_t) length);
  set64(damaged + 64, 200);
  if (!critbit0_image_init(&bad, damaged, length)) return 1;
  key = "";
  calls = 0;
  stop_at = 0;
  printf("walk reaches damaged cb:\n");
  printf("  result %d\n",
         critbit0_image_allprefixed(&bad, &pool, &suffix, &key, show));
  str0_free(&suffix, &pool);

  critbit0_clear(&tree, &pool);
  return 0;
}
EOF
if ! "${CC:-cc}" -I"${home}/tests/prefix/include" \
  -o "${basedir}/critbit0_image_operations" \
  "${basedir}/critbit0_image_operations.c" \
  -L"${home}/tests/prefix/lib" -lcritbit0 2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/critbit0_image_operations"

_run cbt-mmap-lf
