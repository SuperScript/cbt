cat > "${basedir}/cbt_after_failure.c" <<'EOF'
#define main cbt_program_main
#include "../../cbt.c"
#undef main

int main(void)
{
  critbit0_tree tree = { 0 };
  limitmalloc_pool pool = { LIMITMALLOC_MAX, 0, 0 };
  char add[] = "add ab";
  char request[] = "after a";

  if (dispatch(add, &tree, &pool) != 0) return 1;
  pool.limitmalloc_private_limit = pool.limitmalloc_private_allocated;
  return dispatch(request, &tree, &pool) == 1 ? 0 : 1;
}
EOF
if ! "${CC:-cc}" -I. -o "${basedir}/cbt_after_failure" \
  "${basedir}/cbt_after_failure.c" libcritbit0.a 2> "${basedir}/compile.err"
