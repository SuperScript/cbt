#!/bin/sh

home="$(pwd)"
basedir="${home}/tests/basedir"

####

_sanitize() {
  sed \
    -e "s!${basedir}!...!g" \
    -e "s!${home}!...!g"
}

_check() {
  { "$@" 2>&1; echo "$?"; } | _sanitize
}

_check_err() {
  { "$@" 2>&1; echo "$?"; } | grep -E 'fatal:|^[0-9]+' | _sanitize
}

_run() {
  printf '\n\n==== %s ====\n\n'  "$1"
}

_json() {
  jq -r "$@" | _sanitize
}

_cbt() {
  { printf '%s\n' "$@" | sed 's/\\t/	/' | ./cbt 2>&1; echo "$?"; } | _sanitize
}

_cbt_installed() {
  { printf '%s\n' "$@" | sed 's/\\t/	/' | "${home}/tests/prefix/bin/cbt" 2>&1; echo "$?"; } | _sanitize
}

_hex() {
  od -An -tx1 | tr -d ' \n'
  printf '\n'
}

####

rm -rf "${basedir:?}/"*
rmdir "${basedir}" 2>/dev/null; true

####


_run critbit0-baseline
mkdir -p "${basedir}"
if ! "${CC:-cc}" -I. -o "${basedir}/critbit0_baseline" \
  tests/critbit0_baseline.c \
  critbit0_contains.c critbit0_insert.c critbit0_delete.c \
  critbit0_clear.c critbit0_firstprefixed.c critbit0_allprefixed.c \
  str0_length.c str0_equalc.c str0_copyc.c str0_free.c \
  limitmalloc_open.c limitmalloc_open_if2.c limitmalloc_close.c \
  2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/critbit0_baseline"

_run critbit0-operations
if ! "${CC:-cc}" -I. -o "${basedir}/critbit0_operations" \
  tests/critbit0_operations.c \
  critbit0_contains.c critbit0_insert.c critbit0_delete.c \
  critbit0_clear.c critbit0_firstprefixed.c critbit0_allprefixed.c \
  str0_length.c str0_equalc.c str0_copyc.c str0_free.c \
  limitmalloc_open.c limitmalloc_open_if2.c limitmalloc_close.c \
  2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/critbit0_operations"

_run critbit0-installed
if ! "${CC:-cc}" -I"${home}/tests/prefix/include" \
  -o "${basedir}/critbit0_installed" tests/critbit0_installed.c \
  -L"${home}/tests/prefix/lib" -lcritbit0 \
  2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/critbit0_installed"

_run installed-library-command-consistency
if ! "${CC:-cc}" -I"${home}/tests/prefix/include" \
  -o "${basedir}/critbit0_cbt" tests/critbit0_cbt.c \
  -L"${home}/tests/prefix/lib" -lcritbit0 \
  2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
if ! "${basedir}/critbit0_cbt" > "${basedir}/requests"
then
  printf '%s\n' 'installed library request generation failed' >&2
  exit 1
fi
{ "${home}/tests/prefix/bin/cbt" < "${basedir}/requests" 2>&1; echo "$?"; } | _sanitize

_run cbt-retained-state
_cbt 'add alpha' 'has alpha' 'add alpha' 'has beta'

_run cbt-delete
_cbt 'rm x' 'add x' 'rm x' 'has x'

_run cbt-clear
_cbt 'add x' 'clear' 'has x' 'clear'

_run cbt-firstprefixed
_cbt 'after a' 'add ab' 'after a' 'after z'

_run cbt-allprefixed
_cbt 'list z' 'add ab' 'add ac' 'list a'

_run cbt-contains-absent-lf
_cbt 'has x'

_run cbt-contains-present-lf
_cbt 'add x' 'has x'

_run cbt-insert-added-lf
_cbt 'add x'

_run cbt-insert-existing-lf
_cbt 'add x' 'add x'

_run cbt-delete-missing-lf
_cbt 'rm x'

_run cbt-delete-present-lf
_cbt 'add x' 'rm x'

_run cbt-clear-silent-lf
_cbt 'clear'

_run cbt-allprefixed-full-keys
_cbt 'add ab' 'add ac' 'list a'

_run cbt-allprefixed-unmatched
_cbt 'list z'

_run cbt-empty-key
_cbt 'add ' 'has ' 'after ' 'list '

_run cbt-allprefixed-empty-key-refusal
{ printf 'add \nlist \n' | ./cbt > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"
cat "${basedir}/load-error"

_run cbt-insert-allocation-failure
cat > "${basedir}/cbt_insert_failure.c" <<'EOF'
#define main cbt_program_main
#include "../../cbt.c"
#undef main

int main(void)
{
  critbit0_tree tree = { 0 };
  limitmalloc_pool pool = { 0, 0, 0 };
  char request[] = "add x";
  return dispatch(request, &tree, &pool) == 1 ? 0 : 1;
}
EOF
if ! "${CC:-cc}" -I. -o "${basedir}/cbt_insert_failure" \
  "${basedir}/cbt_insert_failure.c" libcritbit0.a 2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/cbt_insert_failure"

_run cbt-after-empty-suffix-lf
_cbt 'add ca' 'after ca'

_run cbt-after-empty-suffix-nul
{ printf 'add ca\000after ca\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-after-allocation-failure
cat > "${basedir}/cbt_after_failure.c" <<'EOF'
#define main cbt_program_main
#include "../../cbt.c"
#undef main

int main(void)
{
  critbit0_tree tree = { 0 };
  limitmalloc_pool pool = { LIMITMALLOC_MAX, 0, 0 };
  char add[] = "add ab";
  char request[] = "after a";

  if (dispatch(add, &tree, &pool) != 0) return 1;
  pool.limitmalloc_private_limit = pool.limitmalloc_private_allocated;
  return dispatch(request, &tree, &pool) == 1 ? 0 : 1;
}
EOF
if ! "${CC:-cc}" -I. -o "${basedir}/cbt_after_failure" \
  "${basedir}/cbt_after_failure.c" libcritbit0.a 2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/cbt_after_failure"

_run cbt-raw-lf-bytes
{ printf 'add A\\\t\001\177\nhas A\\\t\001\177\nafter A\nlist A\n' \
| "${home}/tests/prefix/bin/cbt" > "${basedir}/raw-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"

_run cbt-literal-old-escapes
{ printf 'add A\\n\\x41\nafter A\n' \
| "${home}/tests/prefix/bin/cbt" > "${basedir}/raw-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"

_run cbt-invalid-verb
_cbt 'unknown\tx' 'add x'

_run cbt-invalid-nul
{ printf 'add x\000y\n' | "${home}/tests/prefix/bin/cbt" 2>&1; echo "$?"; } | _sanitize

_run cbt-lf-boundary
{ printf 'add x\ny\n' | "${home}/tests/prefix/bin/cbt" 2>&1; echo "$?"; } | _sanitize

_run cbt-unterminated
{ printf 'add x' | ./cbt 2>&1; echo "$?"; } | _sanitize

_run cbt-nul-stream
{ printf 'add pre\n\t\\z\000has pre\n\t\\z\000after pre\000list pre\000' \
| "${home}/tests/prefix/bin/cbt" -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-contains-absent-nul
{ printf 'has x\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-contains-present-nul
{ printf 'add x\000has x\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-insert-added-nul
{ printf 'add x\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-insert-existing-nul
{ printf 'add x\000add x\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-delete-missing-nul
{ printf 'rm x\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-delete-present-nul
{ printf 'add x\000rm x\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-clear-silent-nul
{ printf 'clear\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-nul-statuses
: > "${basedir}/nul-empty"
{ printf 'has x\000add x\000add x\000rm y\000rm x\000after x\000list x\000clear\000save tests/basedir/nul-empty\000load tests/basedir/nul-empty\000' \
| "${home}/tests/prefix/bin/cbt" -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-nul-incomplete
{ printf 'add x' | "${home}/tests/prefix/bin/cbt" -0 > "${basedir}/nul-output" 2>&1; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-unsupported-option
{ "${home}/tests/prefix/bin/cbt" -x > "${basedir}/nul-output" 2>&1; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-snapshot-roundtrip
_cbt 'add B' 'add A' \
  'save tests/basedir/snapshot' 'clear' \
  'load tests/basedir/snapshot' 'has A' 'has B'
cat "${basedir}/snapshot" | _sanitize

_run cbt-nul-snapshot
{ printf 'add A\nB\000add C\000save tests/basedir/nul-snapshot\000clear\000load tests/basedir/nul-snapshot\000has A\nB\000has C\000' \
| "${home}/tests/prefix/bin/cbt" -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"
_hex < "${basedir}/nul-snapshot"

_run cbt-snapshot-other-mode
{ printf 'add retained\000load tests/basedir/snapshot\000' \
| "${home}/tests/prefix/bin/cbt" -0 > "${basedir}/nul-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"
cat "${basedir}/load-error"
{ printf 'add retained\nload tests/basedir/nul-snapshot\n' \
| "${home}/tests/prefix/bin/cbt" > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"
cat "${basedir}/load-error"

_run cbt-snapshot-empty
: > "${basedir}/empty"
{ printf 'load tests/basedir/empty\n' | ./cbt > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"
cat "${basedir}/load-error"

_run cbt-load-empty-nul
: > "${basedir}/empty-nul"
{ printf 'load tests/basedir/empty-nul\000' | ./cbt -0 > "${basedir}/nul-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"
cat "${basedir}/load-error"

_run cbt-write-lf
{ printf 'add B\nadd A\nwrite\n' | "${home}/tests/prefix/bin/cbt" > "${basedir}/raw-output"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"

_run cbt-read-lf
{ printf 'add kept\nread\nA\nB\n\nhas A\nhas kept\nhas B\n' | ./cbt > "${basedir}/raw-output"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"

_run cbt-load-layer
_cbt 'add kept' 'add A' 'add B' \
  'save tests/basedir/layer' 'rm A' 'rm B' \
  'load tests/basedir/layer' 'has kept' 'has A' 'has B'

_run cbt-write-nul
{ printf 'add B\000add A\000write\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-read-nul
{ printf 'add kept\000read\000A\000B\000\000has A\000has kept\000has B\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-save-ab-lf
{ printf 'add B\nadd A\nsave tests/basedir/ab-lf\n' | ./cbt > "${basedir}/raw-output"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"
_hex < "${basedir}/ab-lf"

_run cbt-save-ab-nul
{ printf 'add B\000add A\000save tests/basedir/ab-nul\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"
_hex < "${basedir}/ab-nul"

_run cbt-save-empty-lf
{ printf 'save tests/basedir/empty-tree\n' | ./cbt > "${basedir}/raw-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"
_hex < "${basedir}/empty-tree"

_run cbt-save-empty-nul
{ printf 'save tests/basedir/empty-tree-nul\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"
_hex < "${basedir}/empty-tree-nul"

_run cbt-load-after-marker
printf 'A\n\nB\n' > "${basedir}/after-marker"
{ printf 'load tests/basedir/after-marker\n' | ./cbt > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"
cat "${basedir}/load-error"

_run cbt-load-marker-only
printf '\n' > "${basedir}/marker-only"
{ printf 'add x\nload tests/basedir/marker-only\nhas x\n' | ./cbt > "${basedir}/raw-output"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"

_run cbt-load-missing-marker
printf 'A\nB\n' > "${basedir}/no-marker"
{ printf 'add kept\nload tests/basedir/no-marker\n' | ./cbt > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"
cat "${basedir}/load-error"

_run cbt-write-empty-lf
{ printf 'write\n' | ./cbt > "${basedir}/raw-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"

_run cbt-read-empty
{ printf 'add x\nread\n\nhas x\n' | ./cbt > "${basedir}/raw-output"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"

_run cbt-read-missing-marker
{ printf 'add kept\nread\nA\n' | ./cbt > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"
cat "${basedir}/load-error"
cat > "${basedir}/cbt_read_missing.c" <<'EOF'
#define main cbt_program_main
#include "../../cbt.c"
#undef main

int main(void)
{
  critbit0_tree tree = { 0 };
  limitmalloc_pool pool = { LIMITMALLOC_MAX, 0, 0 };
  str0 key = "kept";
  FILE *input;

  if (critbit0_insert(&tree, &pool, &key) != 2) return 1;
  input = fopen("tests/basedir/read-missing", "w");
  if (!input) return 1;
  if (fputs("A\n", input) == EOF || fclose(input) == EOF) return 1;
  if (!freopen("tests/basedir/read-missing", "r", stdin)) return 1;
  if (read_snapshot(&tree, &pool) == 0) return 1;
  if (!critbit0_contains(&tree, &key)) return 1;
  printf("retained: yes\n");
  critbit0_clear(&tree, &pool);
  return 0;
}
EOF
if ! "${CC:-cc}" -I. -o "${basedir}/cbt_read_missing" \
  "${basedir}/cbt_read_missing.c" libcritbit0.a 2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/cbt_read_missing"

_run cbt-write-empty-key
{ printf 'add \nwrite\n' | ./cbt > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"
cat "${basedir}/load-error"

_run cbt-save-empty-key
{ printf 'add \nsave tests/basedir/empty-key-save\n' | ./cbt > "${basedir}/raw-output" 2> "${basedir}/load-error"; echo "$?"; } | _sanitize
cat "${basedir}/raw-output"
cat "${basedir}/load-error"
test ! -e "${basedir}/empty-key-save"
echo "$?"

_run cbt-snapshot-invalid
printf 'valid\nx\000y\n' > "${basedir}/invalid"
_cbt_installed 'add x' 'load tests/basedir/invalid' 'has x'

_run cbt-snapshot-lf-boundary
printf 'valid\nunterminated' > "${basedir}/invalid"
_cbt_installed 'add x' 'load tests/basedir/invalid' 'has x'

_run cbt-snapshot-raw-bytes
{ printf 'add A\\\t\001\177\nadd A\\n\\x41\nsave tests/basedir/raw-snapshot\nclear\nload tests/basedir/raw-snapshot\nhas A\\\t\001\177\nhas A\\n\\x41\n' \
| "${home}/tests/prefix/bin/cbt" > "${basedir}/raw-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"
_hex < "${basedir}/raw-snapshot"

_run cbt-snapshot-missing
_cbt_installed 'add x' 'load tests/basedir/missing'

_run cbt-snapshot-save-symlink
printf 'prior\n' > "${basedir}/prior"
ln -s prior "${basedir}/link"
_cbt_installed 'add x' 'save tests/basedir/link'
cat "${basedir}/prior"

_run cbt-installed-all-bytes
awk 'BEGIN {
  key = ""
  for (i = 1; i < 256; i++) {
    if (i != 10) key = key sprintf("%c", i)
  }
  printf "add %s\nsave tests/basedir/all-bytes\nclear\nload tests/basedir/all-bytes\nhas %s\n", key, key
}' | "${home}/tests/prefix/bin/cbt" 2>&1 | _sanitize

_run cbt-installed-executable
test -x "${home}/tests/prefix/bin/cbt"
echo "$?"

_run cbt-snapshot-rollback
printf 'prior\n' > "${basedir}/rollback"
if ! "${CC:-cc}" -I. -o "${basedir}/cbt_snapshots" \
  tests/cbt_snapshots.c libcritbit0.a 2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/cbt_snapshots" "${basedir}/bad-load" "${basedir}/rollback"

_run cbt-has-space-absent-lf
_cbt 'has a b'

_run cbt-has-space-present-lf
_cbt 'add a b' 'has a b'

_run cbt-add-space-added-lf
_cbt 'add a b'

_run cbt-add-space-existing-lf
_cbt 'add a b' 'add a b'

_run cbt-rm-space-missing-lf
_cbt 'rm a b'

_run cbt-rm-space-present-lf
_cbt 'add a b' 'rm a b'

_run cbt-after-space-unmatched-lf
_cbt 'after a b'

_run cbt-after-space-matched-lf
_cbt 'add a bx' 'after a b'

_run cbt-list-space-unmatched-lf
_cbt 'list a b'

_run cbt-list-space-matched-lf
_cbt 'add a b' 'list a b'

_run cbt-has-empty-absent-lf
_cbt 'has '

_run cbt-has-empty-present-lf
_cbt 'add ' 'has '

_run cbt-add-empty-added-lf
_cbt 'add '

_run cbt-add-empty-existing-lf
_cbt 'add ' 'add '

_run cbt-rm-empty-missing-lf
_cbt 'rm '

_run cbt-rm-empty-present-lf
_cbt 'add ' 'rm '

_run cbt-after-empty-unmatched-lf
_cbt 'after '

_run cbt-after-empty-matched-lf
_cbt 'add x' 'after '

_run cbt-list-empty-unmatched-lf
_cbt 'list '

_run cbt-list-empty-matched-lf
_cbt 'add x' 'list '

_run cbt-has-space-absent-nul
{ printf 'has a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-has-space-present-nul
{ printf 'add a b\000has a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-add-space-added-nul
{ printf 'add a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-add-space-existing-nul
{ printf 'add a b\000add a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-rm-space-missing-nul
{ printf 'rm a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-rm-space-present-nul
{ printf 'add a b\000rm a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-after-space-unmatched-nul
{ printf 'after a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-after-space-matched-nul
{ printf 'add a bx\000after a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-list-space-unmatched-nul
{ printf 'list a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-list-space-matched-nul
{ printf 'add a b\000list a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-has-empty-absent-nul
{ printf 'has \000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-has-empty-present-nul
{ printf 'add \000has \000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-add-empty-added-nul
{ printf 'add \000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-add-empty-existing-nul
{ printf 'add \000add \000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-rm-empty-missing-nul
{ printf 'rm \000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-rm-empty-present-nul
{ printf 'add \000rm \000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-after-empty-unmatched-nul
{ printf 'after \000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-after-empty-matched-nul
