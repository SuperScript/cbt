#define main cbt_program_main
#include "../../cbt.c"
#undef main

int main(void)
{
  critbit0_tree tree = { 0 };
  limitmalloc_pool pool = { 0, 0, 0 };
  char request[] = "add x";
  return dispatch(request, &tree, &pool) == 1 ? 0 : 1;
}
EOF
