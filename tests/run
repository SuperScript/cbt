_run cbt-dump-write-error
cat > "${basedir}/cbt_dump_write.c" <<'EOF'
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>

static size_t failing_fwrite(const void *bytes, size_t size, size_t count,
                             FILE *stream)
{
  (void) bytes;
  (void) size;
  (void) count;
  (void) stream;
  return 0;
}

#define fwrite failing_fwrite
#define main cbt_program_main
#include "../../cbt.c"
#undef main

int main(void)
{
  critbit0_tree tree = { 0 };
  limitmalloc_pool pool = { LIMITMALLOC_MAX, 0, 0 };
  char add[] = "add a";
  char request[] = "dump tests/basedir/write-error.dump";

  if (dispatch(add, &tree, &pool) != 0) return 2;
  return dispatch(request, &tree, &pool);
}
EOF
if ! "${CC:-cc}" -I. -o "${basedir}/cbt_dump_write" \
