cat "${basedir}/load-error"
cat > "${basedir}/cbt_read_missing.c" <<'EOF'
#define main cbt_program_main
#include "../../cbt.c"
#undef main

int main(void)
{
  critbit0_tree tree = { 0 };
  limitmalloc_pool pool = { LIMITMALLOC_MAX, 0, 0 };
  str0 key = "kept";
  FILE *input;

  if (critbit0_insert(&tree, &pool, &key) != 2) return 1;
  input = fopen("tests/basedir/read-missing", "w");
  if (!input) return 1;
  if (fputs("A\n", input) == EOF || fclose(input) == EOF) return 1;
  if (!freopen("tests/basedir/read-missing", "r", stdin)) return 1;
  if (read_snapshot(&tree, &pool) == 0) return 1;
  if (!critbit0_contains(&tree, &key)) return 1;
  printf("retained: yes\n");
  critbit0_clear(&tree, &pool);
  return 0;
}
EOF
if ! "${CC:-cc}" -I. -o "${basedir}/cbt_read_missing" \
  "${basedir}/cbt_read_missing.c" libcritbit0.a 2> "${basedir}/compile.err"
then
