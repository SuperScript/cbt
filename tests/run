printf 'a\n\n' > "${basedir}/not-dump.snapshot"
: > "${basedir}/zero.dump"
head -c 64 "${basedir}/ab.dump" > "${basedir}/short.dump"
{ head -c 8 "${basedir}/ab.dump"; printf '\002'; tail -c +10 "${basedir}/ab.dump"; } > "${basedir}/version.dump"
head -c 31 "${basedir}/ab.dump" > "${basedir}/tiny.dump"
for name in not-dump.snapshot zero.dump short.dump version.dump tiny.dump
do
  _cbt_arguments -m "${basedir}/${name}"
done

_run cbt-mmap-malformed-record
_dump "${basedir}/ab.dump" b a
{ head -c 48 "${basedir}/ab.dump"; printf '\110\0\0\0\0\0\0\0'; tail -c 16 "${basedir}/ab.dump"; } > "${basedir}/bad-child.dump"
for request in 'has a' 'after a' 'list a' 'complete a' 'save tests/basedir/bad.snapshot' 'write'
do
  _cbt_mapped "${basedir}/bad-child.dump" "${request}"
done
_cbt_mapped "${basedir}/bad-child.dump" 'has b' 'list b'

_run cbt-mmap-malformed-record-after-output
_dump "${basedir}/m.dump" ca cb a
{ head -c 64 "${basedir}/m.dump"; printf '\310\0\0\0\0\0\0\0'; tail -c +73 "${basedir}/m.dump"; } > "${basedir}/bad-cb.dump"
_cbt_mapped "${basedir}/bad-cb.dump" 'has a' 'has ca'
_cbt_mapped "${basedir}/bad-cb.dump" 'complete '
_cbt_mapped "${basedir}/bad-cb.dump" 'list c'
_cbt_mapped "${basedir}/bad-cb.dump" 'save tests/basedir/bad-cb.snapshot'
cat "${basedir}/bad-cb.snapshot"
_cbt_mapped "${basedir}/bad-cb.dump" 'write'

_run cbt-mmap-cannot-map
_dump "${basedir}/m.dump" a
cat > "${basedir}/cbt_mmap_fail.c" <<'EOF'
#define _POSIX_C_SOURCE 200809L
#include <errno.h>
#include <sys/mman.h>
#include <sys/types.h>

static void *failing_mmap(void *address, size_t length, int protection,
                          int flags, int fd, off_t offset)
{
  (void) address;
  (void) length;
  (void) protection;
  (void) flags;
  (void) fd;
  (void) offset;
  errno = ENOMEM;
  return MAP_FAILED;
}

#define mmap failing_mmap
#define main cbt_program_main
#include "../../cbt.c"
#undef main

/* Usage: cbt_mmap_fail dump
   Run cbt -m dump with mmap failing. */
int main(int argc, char **argv)
{
  char *arguments[] = { "cbt", "-m", 0, 0 };

  if (argc != 2) return 2;
  arguments[2] = argv[1];
  return cbt_program_main(3, arguments);
}
EOF
if ! "${CC:-cc}" -I. -o "${basedir}/cbt_mmap_fail" \
  "${basedir}/cbt_mmap_fail.c" libcritbit0.a 2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/cbt_mmap_fail" "${basedir}/m.dump" < /dev/null

_run make-header-dependencies
_make_stubs "${basedir}/make"
(
  cd "${basedir}/make" || exit 1
  for header in critbit0.h str0.h limitmalloc.h int64.h uint8.h uint32.h uint64.h
  do
    touch -t 200001020000 "${header}"
    for target in critbit0_insert.o critbit0_dump.o str0_free.o limitmalloc_open.o cbt
    do
      stale=0
      if "${MAKE:-make}" -n CC=compile AR=archive "${target}" 2> /dev/null \
        | grep -q -E '(compile|archive) '
      then
        stale=1
      fi
      printf '%s %s %s\n' "${header}" "${target}" "${stale}"
    done
    touch -t 200001010000 "${header}"
  done
)

_run make-clean
_make_stubs "${basedir}/make-clean"
(
  cd "${basedir}/make-clean" || exit 1
  mkdir -p tests/basedir/sub tests/prefix/bin
  : > tests/output
  : > tests/basedir/sub/file
  : > tests/prefix/bin/cbt
  "${MAKE:-make}" clean > /dev/null 2>&1
  echo "$?"
  ls tests
  ls | grep -E '[.]o$|^libcritbit0[.]a$|^cbt$'
  ls cbt.c critbit0.h
)

_run make-failed-cbt-leaves-no-temp
_make_stubs "${basedir}/make-cbt"
(
  cd "${basedir}/make-cbt" || exit 1
  touch -t 200001020000 cbt.c
  if "${MAKE:-make}" CC=false cbt > /dev/null 2>&1
  then
    echo built
  else
    echo failed
  fi
  ls | grep '^cbt'
)

_run make-failed-library-leaves-no-temp
_make_stubs "${basedir}/make-library"
(
  cd "${basedir}/make-library" || exit 1
  touch -t 200001020000 critbit0_insert.o
  if "${MAKE:-make}" AR=false libcritbit0.a > /dev/null 2>&1
  then
    echo built
  else
    echo failed
  fi
  ls | grep '^libcritbit0'
)

_run make-install-modes
rm -rf "${basedir}/install"
"${MAKE:-make}" install PREFIX="${basedir}/install" > /dev/null 2>&1
echo "$?"
ls -l "${basedir}/install/bin/cbt" "${basedir}/install/lib/libcritbit0.a" "${basedir}/install/include/critbit0.h" \
| awk '{ print $1, $NF }' | _sanitize
ls "${basedir}/install/bin" "${basedir}/install/lib" "${basedir}/install/include" | _sanitize
