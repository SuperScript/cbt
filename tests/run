printf 'valid\nx\000y\n' > "${basedir}/invalid"
_cbt_installed 'add x' 'load tests/basedir/invalid' 'has x'

_run cbt-snapshot-lf-boundary
printf 'valid\nunterminated' > "${basedir}/invalid"
_cbt_installed 'add x' 'load tests/basedir/invalid' 'has x'

_run cbt-snapshot-raw-bytes
{ printf 'add A\\\t\001\177\nadd A\\n\\x41\nsave tests/basedir/raw-snapshot\nclear\nload tests/basedir/raw-snapshot\nhas A\\\t\001\177\nhas A\\n\\x41\n' \
| "${home}/tests/prefix/bin/cbt" > "${basedir}/raw-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/raw-output"
_hex < "${basedir}/raw-snapshot"

_run cbt-snapshot-missing
_cbt_installed 'add x' 'load tests/basedir/missing'

_run cbt-snapshot-save-symlink
printf 'prior\n' > "${basedir}/prior"
ln -s prior "${basedir}/link"
_cbt_installed 'add x' 'save tests/basedir/link'
cat "${basedir}/prior"

_run cbt-installed-all-bytes
awk 'BEGIN {
  key = ""
  for (i = 1; i < 256; i++) {
    if (i != 10) key = key sprintf("%c", i)
  }
  printf "add %s\nsave tests/basedir/all-bytes\nclear\nload tests/basedir/all-bytes\nhas %s\n", key, key
}' | "${home}/tests/prefix/bin/cbt" 2>&1 | _sanitize

_run cbt-installed-executable
test -x "${home}/tests/prefix/bin/cbt"
echo "$?"

_run cbt-snapshot-rollback
printf 'prior\n' > "${basedir}/rollback"
if ! "${CC:-cc}" -I. -o "${basedir}/cbt_snapshots" \
  tests/cbt_snapshots.c libcritbit0.a 2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/cbt_snapshots" "${basedir}/bad-load" "${basedir}/rollback"

_run cbt-has-space-absent-lf
_cbt 'has a b'

_run cbt-has-space-present-lf
_cbt 'add a b' 'has a b'

_run cbt-add-space-added-lf
_cbt 'add a b'

_run cbt-add-space-existing-lf
_cbt 'add a b' 'add a b'

_run cbt-rm-space-missing-lf
_cbt 'rm a b'

_run cbt-rm-space-present-lf
_cbt 'add a b' 'rm a b'

_run cbt-after-space-unmatched-lf
_cbt 'after a b'

_run cbt-after-space-matched-lf
_cbt 'add a bx' 'after a b'

_run cbt-list-space-unmatched-lf
_cbt 'list a b'

_run cbt-list-space-matched-lf
_cbt 'add a b' 'list a b'

_run cbt-has-empty-absent-lf
_cbt 'has '

_run cbt-has-empty-present-lf
_cbt 'add ' 'has '

_run cbt-add-empty-added-lf
_cbt 'add '

_run cbt-add-empty-existing-lf
_cbt 'add ' 'add '

_run cbt-rm-empty-missing-lf
_cbt 'rm '

_run cbt-rm-empty-present-lf
_cbt 'add ' 'rm '

_run cbt-after-empty-unmatched-lf
_cbt 'after '

_run cbt-after-empty-matched-lf
_cbt 'add x' 'after '

_run cbt-list-empty-unmatched-lf
_cbt 'list '

_run cbt-list-empty-matched-lf
_cbt 'add x' 'list '

_run cbt-has-space-absent-nul
{ printf 'has a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-has-space-present-nul
{ printf 'add a b\000has a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-add-space-added-nul
{ printf 'add a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-add-space-existing-nul
{ printf 'add a b\000add a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
