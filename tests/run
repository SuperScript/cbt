_run cbt-mmap-nul
_dump "${basedir}/m.dump" ca cb a
{ printf 'has ca\000list c\000' | "${home}/tests/prefix/bin/cbt" -0 -m "${basedir}/m.dump" > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"
{ printf 'has ca\000list c\000' | "${home}/tests/prefix/bin/cbt" -m "${basedir}/m.dump" -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"
{ printf 'has ca\000' | "${home}/tests/prefix/bin/cbt" -m"${basedir}/m.dump" -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

