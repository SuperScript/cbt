cat > "${basedir}/cbt_dispatch.c" <<'EOF'
#define main cbt_program_main
#include "../../cbt.c"
#undef main

/* Usage: cbt_dispatch limited|unlimited request
   Add "ab", optionally stop further allocation, then dispatch request. */
int main(int argc, char **argv)
{
  critbit0_tree tree = { 0 };
  limitmalloc_pool pool = { LIMITMALLOC_MAX, 0, 0 };
  char add[] = "add ab";

  if (argc != 3) return 2;
  if (dispatch(add, &tree, &pool) != 0) return 2;
  if (strcmp(argv[1], "limited") == 0)
    pool.limitmalloc_private_limit = pool.limitmalloc_private_allocated;
  return dispatch(argv[2], &tree, &pool);
}
EOF
if ! "${CC:-cc}" -I. -o "${basedir}/cbt_dispatch" \
  "${basedir}/cbt_dispatch.c" libcritbit0.a 2> "${basedir}/compile.err"
