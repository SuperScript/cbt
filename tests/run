#!/bin/sh

home="$(pwd)"
basedir="${home}/tests/basedir"

####

_sanitize() {
  sed \
    -e "s!${basedir}!...!g" \
    -e "s!${home}!...!g"
}

_check() {
  { "$@" 2>&1; echo "$?"; } | _sanitize
}

_check_err() {
  { "$@" 2>&1; echo "$?"; } | grep -E 'fatal:|^[0-9]+' | _sanitize
}

_run() {
  printf '\n\n==== %s ====\n\n'  "$1"
}

_json() {
  jq -r "$@" | _sanitize
}

_cbt() {
  { printf '%s\n' "$@" | sed 's/\\t/	/' | ./cbt 2>&1; echo "$?"; } | _sanitize
}

_cbt_installed() {
  { printf '%s\n' "$@" | sed 's/\\t/	/' | "${home}/tests/prefix/bin/cbt" 2>&1; echo "$?"; } | _sanitize
}

####

rm -rf "${basedir:?}/"*
rmdir "${basedir}" 2>/dev/null; true

####


_run critbit0-baseline
mkdir -p "${basedir}"
if ! "${CC:-cc}" -I. -o "${basedir}/critbit0_baseline" \
  tests/critbit0_baseline.c \
  critbit0_contains.c critbit0_insert.c critbit0_delete.c \
  critbit0_clear.c critbit0_firstprefixed.c critbit0_allprefixed.c \
  str0_length.c str0_equalc.c str0_copyc.c str0_free.c \
  limitmalloc_open.c limitmalloc_open_if2.c limitmalloc_close.c \
  2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/critbit0_baseline"

_run critbit0-operations
if ! "${CC:-cc}" -I. -o "${basedir}/critbit0_operations" \
  tests/critbit0_operations.c \
  critbit0_contains.c critbit0_insert.c critbit0_delete.c \
  critbit0_clear.c critbit0_firstprefixed.c critbit0_allprefixed.c \
  str0_length.c str0_equalc.c str0_copyc.c str0_free.c \
  limitmalloc_open.c limitmalloc_open_if2.c limitmalloc_close.c \
  2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/critbit0_operations"

_run critbit0-installed
if ! "${CC:-cc}" -I"${home}/tests/prefix/include" \
  -o "${basedir}/critbit0_installed" tests/critbit0_installed.c \
  -L"${home}/tests/prefix/lib" -lcritbit0 \
  2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/critbit0_installed"

_run installed-library-command-consistency
if ! "${CC:-cc}" -I"${home}/tests/prefix/include" \
  -o "${basedir}/critbit0_cbt" tests/critbit0_cbt.c \
  -L"${home}/tests/prefix/lib" -lcritbit0 \
  2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
if ! "${basedir}/critbit0_cbt" > "${basedir}/requests"
then
  printf '%s\n' 'installed library request generation failed' >&2
  exit 1
fi
{ "${home}/tests/prefix/bin/cbt" < "${basedir}/requests" 2>&1; echo "$?"; } | _sanitize

_run cbt-retained-state
_cbt 'insert\talpha' 'contains\talpha' 'insert\talpha' 'contains\tbeta'

_run cbt-delete
_cbt 'delete\tx' 'insert\tx' 'delete\tx' 'contains\tx'

_run cbt-clear
_cbt 'insert\tx' 'clear' 'contains\tx' 'clear'

_run cbt-firstprefixed
_cbt 'firstprefixed\ta' 'insert\tab' 'firstprefixed\ta' 'firstprefixed\tz'

_run cbt-allprefixed
_cbt 'allprefixed\tz' 'insert\tab' 'insert\tac' 'allprefixed\ta'

_run cbt-empty-key
_cbt 'insert\t' 'contains\t' 'firstprefixed\t' 'allprefixed\t'

_run cbt-escaped-bytes
_cbt 'insert\tA\\\t\n\r\x01\x80' 'contains\tA\\\t\n\r\x01\x80' 'firstprefixed\tA' 'allprefixed\tA'

_run cbt-invalid-verb
_cbt 'unknown\tx' 'insert\tx'

_run cbt-invalid-escape
_cbt 'insert\t\q' 'contains\tx'

_run cbt-invalid-nul
_cbt 'insert\t\x00' 'contains\tx'

_run cbt-invalid-hex
_cbt 'insert\t\x41' 'contains\tx'

_run cbt-invalid-control
{ printf 'insert\tx\001\ncontains\tx\n' | ./cbt 2>&1; echo "$?"; } | _sanitize

_run cbt-unterminated
{ printf 'insert\tx' | ./cbt 2>&1; echo "$?"; } | _sanitize

_run cbt-snapshot-roundtrip
_cbt 'insert\t' 'insert\tB' 'insert\tA' \
  'save\ttests/basedir/snapshot' 'clear' \
  'load\ttests/basedir/snapshot' 'contains\tA' 'contains\tB' 'contains\t'
cat "${basedir}/snapshot" | _sanitize

_run cbt-snapshot-empty
: > "${basedir}/empty"
_cbt 'insert\tx' 'load\ttests/basedir/empty' 'contains\tx' \
  'save\ttests/basedir/empty'
test ! -s "${basedir}/empty"
echo "$?"

_run cbt-snapshot-invalid
printf 'valid\n\\x00\n' > "${basedir}/invalid"
_cbt_installed 'insert\tx' 'load\ttests/basedir/invalid' 'contains\tx'

_run cbt-snapshot-missing
_cbt_installed 'insert\tx' 'load\ttests/basedir/missing'

_run cbt-snapshot-save-symlink
printf 'prior\n' > "${basedir}/prior"
ln -s prior "${basedir}/link"
_cbt_installed 'insert\tx' 'save\ttests/basedir/link'
cat "${basedir}/prior"

_run cbt-installed-all-bytes
awk 'BEGIN {
  key = ""
  for (i = 1; i < 256; i++) {
    if (i == 9) key = key "\\t"
    else if (i == 10) key = key "\\n"
    else if (i == 13) key = key "\\r"
    else if (i == 92) key = key "\\\\"
    else if (i >= 32 && i <= 126) key = key sprintf("%c", i)
    else key = key sprintf("\\x%02X", i)
  }
  printf "insert\t%s\nsave\ttests/basedir/all-bytes\nclear\nload\ttests/basedir/all-bytes\ncontains\t%s\n", key, key
}' | "${home}/tests/prefix/bin/cbt" 2>&1 | _sanitize

_run cbt-installed-executable
test -x "${home}/tests/prefix/bin/cbt"
echo "$?"

_run cbt-snapshot-rollback
printf 'prior\n' > "${basedir}/rollback"
if ! "${CC:-cc}" -I. -o "${basedir}/cbt_snapshots" \
  tests/cbt_snapshots.c libcritbit0.a 2> "${basedir}/compile.err"
then
  cat "${basedir}/compile.err" >&2
  exit 1
fi
_check "${basedir}/cbt_snapshots" "${basedir}/bad-load" "${basedir}/rollback"
