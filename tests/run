_run cbt-after-space-matched-nul
{ printf 'add a bx\000after a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-list-space-unmatched-nul
{ printf 'list a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-list-space-matched-nul
{ printf 'add a b\000list a b\000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-has-empty-absent-nul
{ printf 'has \000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-has-empty-present-nul
{ printf 'add \000has \000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-add-empty-added-nul
{ printf 'add \000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-add-empty-existing-nul
{ printf 'add \000add \000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-rm-empty-missing-nul
{ printf 'rm \000' | ./cbt -0 > "${basedir}/nul-output"; echo "$?"; } | _sanitize
_hex < "${basedir}/nul-output"

_run cbt-rm-empty-present-nul
